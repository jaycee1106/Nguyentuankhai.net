{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1144px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "name": "Navy (nền tối)", "color": "#07142b" },
				{ "slug": "navy-2", "name": "Navy nhạt (thẻ)", "color": "#0c1f42" },
				{ "slug": "navy-3", "name": "Navy đậm (chân trang)", "color": "#040d1d" },
				{ "slug": "light", "name": "Nền sáng", "color": "#f5f9ff" },
				{ "slug": "white", "name": "Trắng", "color": "#ffffff" },
				{ "slug": "ink", "name": "Chữ đậm", "color": "#0b1b33" },
				{ "slug": "muted", "name": "Chữ phụ (nền sáng)", "color": "#51627d" },
				{ "slug": "muted-dark", "name": "Chữ phụ (nền tối)", "color": "#9fb0cc" },
				{ "slug": "blue", "name": "Xanh dương", "color": "#1d5cff" },
				{ "slug": "cyan", "name": "Xanh cyan", "color": "#00c2ff" },
				{ "slug": "zalo", "name": "Xanh Zalo", "color": "#0068ff" }
			],
			"gradients": [
				{ "slug": "brand", "name": "Gradient thương hiệu", "gradient": "linear-gradient(120deg,#1d5cff 0%,#00c2ff 100%)" },
				{ "slug": "night", "name": "Đêm", "gradient": "linear-gradient(160deg,#10284f 0%,#081733 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "slug": "heading", "name": "Montserrat (tiêu đề)", "fontFamily": "\"Montserrat\", system-ui, sans-serif" },
				{ "slug": "body", "name": "Be Vietnam Pro (chữ thường)", "fontFamily": "\"Be Vietnam Pro\", system-ui, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Rất nhỏ", "size": "13px", "fluid": false },
				{ "slug": "small", "name": "Nhỏ", "size": "15px", "fluid": false },
				{ "slug": "medium", "name": "Vừa", "size": "18px", "fluid": false },
				{ "slug": "large", "name": "Lớn", "size": "24px", "fluid": { "min": "20px", "max": "28px" } },
				{ "slug": "x-large", "name": "Rất lớn", "size": "40px", "fluid": { "min": "30px", "max": "48px" } },
				{ "slug": "xx-large", "name": "Khổng lồ", "size": "64px", "fluid": { "min": "34px", "max": "64px" } },
				{ "slug": "display", "name": "Tiêu đề trang chủ", "size": "128px", "fluid": { "min": "54px", "max": "128px" } }
			]
		},
		"spacing": {
			"units": [ "px", "%", "em", "rem", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "10px" },
				{ "slug": "30", "name": "S", "size": "16px" },
				{ "slug": "40", "name": "M", "size": "24px" },
				{ "slug": "50", "name": "L", "size": "40px" },
				{ "slug": "60", "name": "XL", "size": "clamp(48px, 6vw, 72px)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(88px, 10vw, 120px)" }
			]
		},
		"border": {
			"radiusSizes": [
				{ "slug": "small", "name": "Nhỏ", "size": "10px" },
				{ "slug": "medium", "name": "Vừa", "size": "18px" },
				{ "slug": "large", "name": "Lớn", "size": "22px" },
				{ "slug": "pill", "name": "Bo tròn", "size": "999px" }
			]
		},
		"custom": {
			"shadow": "0 10px 30px rgba(18,52,120,.08)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--navy)",
			"text": "var(--wp--preset--color--white)"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": { "left": "28px", "right": "28px", "top": "0px", "bottom": "0px" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--cyan)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "800",
					"lineHeight": "1.08",
					"letterSpacing": "-0.03em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"gradient": "var(--wp--preset--gradient--brand)",
					"text": "var(--wp--preset--color--white)"
				},
				"spacing": { "padding": { "top": "15px", "bottom": "15px", "left": "26px", "right": "26px" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"fontSize": "15px",
					"lineHeight": "1.4"
				},
				"shadow": "0 8px 24px rgba(0,140,255,.35)"
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "800" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--cyan)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Đầu trang (menu)", "area": "header" },
		{ "name": "footer", "title": "Chân trang + nút chat nổi", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Trang trống toàn màn hình (tự dựng bằng khối)", "postTypes": [ "page", "du-an" ] }
	],
	"patterns": []
}
